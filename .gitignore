# Datos crudos y derivados. data/raw/ se ignora: los CSV son re-descargables con
# la receta de data/README.md; la inmutabilidad (no mutar raw) se respeta igual.
/data/raw/*
!/data/raw/.gitkeep
/data/clean/*
!/data/clean/.gitkeep
/results/*
!/results/.gitkeep
/data/quality_report.md

# Python / uv
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store

# Pipeline de investigación (base regenerable con `pipeline backfill`)
/data/pipeline/*.db

# Cripto: volcados de libro (grandes, re-descargables); se versiona sólo el MANIFEST
/data/raw_crypto/**/*.zip
/data/raw_crypto/**/*.CHECKSUM
!/data/raw_crypto/MANIFEST.sha256

# Papers: copyright, no redistribuir. Ver data/papers/README.md
data/papers/*.pdf
data/papers/*.PDF
!data/papers/README.md
!data/papers/MANIFEST.md
